[Unit]
Description=ADS-B flight logger for the Thamesmead noise survey
After=readsb.service chrony.service
Wants=readsb.service
# Don't start without the SSD, rather than filling the SD card
RequiresMountsFor=/var/lib/adsb-logger

[Service]
# The adsb package is copied to /opt/adsb-logger/adsb; see docs/pi-setup.md
Environment=PYTHONPATH=/opt/adsb-logger
ExecStart=/usr/bin/python3 -m adsb log --config /etc/adsb-logger/site.json
User=adsb-logger
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
