[Unit]
Description=ADS-B flight logger for the Thamesmead noise survey
After=readsb.service chrony.service local-fs.target
Wants=readsb.service
# Keep retrying forever (every RestartSec), e.g. while the Pi has booted from an SD card by mistake
StartLimitIntervalSec=0

[Service]
# Installed by deploy/install.sh; see docs/pi-setup.md
Environment=PYTHONPATH=/opt/adsb-logger
# Check the log folder is on the SSD the Pi boots from, not an SD card, and give it to the logger.
# The "+" runs this as root.
ExecStartPre=+/opt/adsb-logger/check-log-disk.sh
ExecStart=/usr/bin/python3 -m adsb log --config /etc/adsb-logger/site.json
User=adsb-logger
# /run/adsb-logger, in memory: the logger lists the files it's writing there, for collect.sh.
# Removed when the logger stops, when every file is finished.
RuntimeDirectory=adsb-logger
Restart=always
# Short enough to lose little data after a crash, long enough not to flood the journal
RestartSec=10

[Install]
WantedBy=multi-user.target
